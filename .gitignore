# ==============================================================================
# SthiraNotes - Comprehensive Workspace .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust & Cargo Build Artifacts
# ------------------------------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb
*.d

# Keep Cargo.lock for reproducible builds of this desktop application workspace:
# !Cargo.lock

# ------------------------------------------------------------------------------
# 2. Node.js, Frontend & Vite Build Outputs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
coverage/
**/coverage/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Tauri Desktop Bundles & Artifacts
# ------------------------------------------------------------------------------
*.app/
*.dmg
*.deb
*.rpm
*.AppImage
*.exe
*.msi
*.wixpdb

# ------------------------------------------------------------------------------
# 4. Local SQLite Databases & Runtime Storage
# ------------------------------------------------------------------------------
# Runtime SQLite database files (created during local app execution / tests)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Local runtime vault and memory mirrors created by the app
.sthira_vault/
.sthira_meta/

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
credentials.json

# ------------------------------------------------------------------------------
# 6. IDEs & Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
*.swp
*.swo

# JetBrains (IntelliJ, RustRover, WebStorm)
.idea/
*.iml

# Visual Studio Code (ignore user workspace settings, preserve extension suggestions)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ------------------------------------------------------------------------------
# 7. Agent & Temporary Execution State
# ------------------------------------------------------------------------------
scratch/
tmp/
*.tmp
.agent_state/
